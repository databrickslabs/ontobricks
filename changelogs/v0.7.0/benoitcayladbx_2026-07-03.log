- scripts/check-deploy-prerequisites.sh
- scripts/_deploy-preflight.sh
- scripts/_lakebase_preflight.py
- scripts/DEPLOY_CHECKLIST.md
- scripts/deploy.sh
- scripts/setup.sh
- scripts/setup-lakebase.sh
- Makefile
- tests/units/scripts/test_lakebase_preflight.py

