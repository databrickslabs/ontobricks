classDiagram
    %% ─── Error Hierarchy ───────────────────────────────────────────────────────
    class Exception
    class RuntimeError
    class OntoBricksError { +error_code_from_class() }
    class NotFoundError
    class AuthorizationError
    class ConflictError
    class ValidationError
    class InfrastructureError
    class OperationCancelledError
    class PoolError
    class StoreError

    Exception    <|-- OntoBricksError
    OntoBricksError <|-- NotFoundError
    OntoBricksError <|-- AuthorizationError
    OntoBricksError <|-- ConflictError
    OntoBricksError <|-- ValidationError
    OntoBricksError <|-- InfrastructureError
    OntoBricksError <|-- OperationCancelledError
    RuntimeError <|-- PoolError
    RuntimeError <|-- StoreError

    %% ─── Storage / Backend Hierarchy (two hats over a shared read root) ─────────
    class ABC
    class GraphBackend {
        <<ABC>>
        +create_table()
        +insert_triples()
        +query_triples()
        +supports_cypher()
        +query_dialect()
        +get_connection()
    }
    class MaterializedGraphBackend {
        <<ABC>>
        +delete_triples()
        +sync_to_remote()
        +rebuild_adjacency()
    }
    class VirtualBackend {
        <<ABC>>
        +read-only, no-copy
    }
    class dReadStore["delta.ReadStore"] {
        +expand_and_fetch_subgraph()
        +execute_query()
    }
    class dMaterializedStore["delta.MaterializedStore"] {
        +create_table()
        +insert_triples()
    }
    class dViewStore["delta.ViewStore"] {
        +pass-through view
    }
    class lBase["lakebase.Base"] {
        +physical_table_id()
        +get_node_table()
        +get_query_translator()
    }
    class lFlatStore["lakebase.FlatStore"] {
        +sync_mode()
        +is_synced()
        +sync_uc_catalog()
    }
    class nStore["neo4j.Store"] {
        +get_connection()
    }

    ABC                      <|-- GraphBackend
    GraphBackend             <|-- MaterializedGraphBackend
    GraphBackend             <|-- VirtualBackend
    MaterializedGraphBackend <|-- lBase
    MaterializedGraphBackend <|-- dMaterializedStore
    MaterializedGraphBackend <|-- nStore
    VirtualBackend           <|-- dViewStore
    dReadStore               <|-- dMaterializedStore
    dReadStore               <|-- dViewStore
    lBase                    <|-- lFlatStore

    %% ─── Graph DB Capabilities (factory-vended, per backend) ────────────────────
    class GraphBuilder { <<ABC>> }
    class GraphHealthProbe { <<ABC>> }
    class GraphProvisioner { <<ABC>> }
    class GraphSimulation {
        <<ABC>>
        +simulation_store()
    }
    class GraphDBFactory {
        +get_graphdb()
        +get_builder()
        +get_health_probe()
        +get_provisioner()
        +get_simulation()
        +classify_store()
    }

    class dBuilder["delta.Builder"]
    class lBuilder["lakebase.Builder"]
    class nBuilder["neo4j.Builder"]
    class dHealthProbe["delta.HealthProbe"]
    class lHealthProbe["lakebase.HealthProbe"]
    class nHealthProbe["neo4j.HealthProbe"]
    class lProvisioner["lakebase.Provisioner"]
    class nProvisioner["neo4j.Provisioner"]
    class dSimulation["delta.Simulation"]
    class lSimulation["lakebase.Simulation"]
    class nSimulation["neo4j.Simulation"]

    GraphBuilder     <|-- dBuilder
    GraphBuilder     <|-- lBuilder
    GraphBuilder     <|-- nBuilder
    GraphHealthProbe <|-- dHealthProbe
    GraphHealthProbe <|-- lHealthProbe
    GraphHealthProbe <|-- nHealthProbe
    GraphProvisioner <|-- lProvisioner
    GraphProvisioner <|-- nProvisioner
    GraphSimulation  <|-- dSimulation
    GraphSimulation  <|-- lSimulation
    GraphSimulation  <|-- nSimulation
    GraphDBFactory ..> GraphBuilder : vends
    GraphDBFactory ..> GraphHealthProbe : vends
    GraphDBFactory ..> GraphProvisioner : vends
    GraphDBFactory ..> GraphSimulation : vends

    %% ─── Registry Store Hierarchy ───────────────────────────────────────────────
    class RegistryStore {
        <<ABC>>
        +is_initialized()
        +initialize()
        +list_domain_folders()
        +list_domains_with_metadata()
    }
    class LakebaseRegistryStore {
        +schema()
        +is_initialized()
        +initialize()
    }

    ABC           <|-- RegistryStore
    RegistryStore <|-- LakebaseRegistryStore

    %% ─── Middleware Hierarchy ────────────────────────────────────────────────────
    class BaseHTTPMiddleware
    class FileSessionMiddleware
    class CSRFMiddleware
    class PermissionMiddleware
    class RequestTimingMiddleware

    BaseHTTPMiddleware <|-- FileSessionMiddleware
    BaseHTTPMiddleware <|-- CSRFMiddleware
    BaseHTTPMiddleware <|-- PermissionMiddleware
    BaseHTTPMiddleware <|-- RequestTimingMiddleware

    %% ─── Settings ────────────────────────────────────────────────────────────────
    class BaseSettings
    class Settings { +sql_warehouse_id() }
    BaseSettings <|-- Settings

    %% ─── Enum ────────────────────────────────────────────────────────────────────
    class Enum
    class TaskStatus
    Enum <|-- TaskStatus

    %% ─── Agents ──────────────────────────────────────────────────────────────────
    class ResponsesAgent
    class OntologyAssistantResponsesAgent {
        +predict()
        +predict_stream()
    }
    ResponsesAgent <|-- OntologyAssistantResponsesAgent

    %% ─── API Model Chain (Pydantic) ─────────────────────────────────────────────
    class BaseModel
    class CredentialsModel
    class DomainPathModel
    class QueryModel
    class UCLocationModel
    class ErrorResponse
    class DomainInfo
    class OntologyStatus
    class TaskProgressResponse
    class StatusResponse

    BaseModel      <|-- CredentialsModel
    CredentialsModel <|-- DomainPathModel
    DomainPathModel  <|-- QueryModel
    DomainPathModel  <|-- UCLocationModel
    BaseModel      <|-- ErrorResponse
    BaseModel      <|-- DomainInfo
    BaseModel      <|-- OntologyStatus
    BaseModel      <|-- TaskProgressResponse
    BaseModel      <|-- StatusResponse

    %% ─── Reasoning Engines (orchestration, no shared base) ──────────────────────
    class ReasoningService {
        +run_full_reasoning()
        +run_tbox_reasoning()
        +run_if_then_rules()
        +run_graph_reasoning()
        +run_sparql_rules()
    }
    class SPARQLRuleEngine { +execute_rules() }
    class ShaclRuleEngine  { +execute_rules() }
    class OWLRLReasoner    { +compute_closure() }

    ReasoningService --> SPARQLRuleEngine    : uses
    ReasoningService --> ShaclRuleEngine     : uses
    ReasoningService --> OWLRLReasoner       : uses

    %% ─── Domain Object Graph (composition) ──────────────────────────────────────
    class DomainSession {
        +save()
        +reset()
        +get_session_status()
    }
    class Domain {
        +get_domain_info()
        +get_domain_stats()
        +import_domain()
    }
    class Ontology {
        +ensure_uris()
        +get_ontology_stats()
    }
    class GenerateWorkflow {
        +run_detection()
        +update_draft()
        +run_completion()
        +merge_draft_into_ontology()
    }
    class OwlGeneratorStaged {
        +detect_entities()
        +infer_relations()
        +infer_attributes()
        +infer_axioms()
    }
    class DigitalTwin {
        +augment_mappings_from_config()
        +get_ts_cache()
        +sync_last_build_from_schedule()
    }
    class Mapping {
        +auto_assign_with_agent()
        +build_entity_mapping()
    }
    class RegistryService {
        +from_context()
        +cfg()
        +store()
    }
    class AgentClient {
        +run_auto_assignment()
    }

    DomainSession --> Domain          : owns
    DomainSession --> RegistryService : uses
    Domain        --> Ontology        : owns
    Domain        --> DigitalTwin     : owns
    Domain        --> Mapping         : owns
    Domain        --> GenerateWorkflow : drives
    Mapping       --> AgentClient     : calls
    DigitalTwin   --> AgentClient     : calls
    DigitalTwin   --> ReasoningService : delegates
    GenerateWorkflow --> OwlGeneratorStaged : calls
    GenerateWorkflow --> Ontology     : appends into
