# Slot pipeline template -- documentation only, intentionally NOT deployed.
#
# OntoBricks creates one Lakeflow Spark Declarative Pipeline per (domain,
# published version) at build time, through ``SlotPipelineRunner.ensure`` in
# ``src/back/core/streaming/SlotPipelineRunner.py``. The pipeline turns the
# row-local R2RML mappings into slot events read from the source tables'
# change feed and folds them with ``AUTO CDC ... STORED AS SCD TYPE 1`` into
# the ``triplestore_<domain>_V<n>_slots`` streaming table; the ``_data``
# materialized view (``REFRESH POLICY INCREMENTAL``) then unions the slots
# with the batch-mapping branches. The SQL is generated by
# ``SlotProjectionCompiler`` and uploaded as a workspace file
# (``/Workspace/Users/<app principal>/.ontobricks/pipelines/<name>.sql``) that
# the pipeline references as a file library, so nothing here has to be kept
# in sync by hand.
#
# Why the ``.example`` suffix: ``databricks.yml`` includes ``resources/*.yml``,
# so a real ``.yml`` file here would be validated and deployed by
# ``make deploy`` as a static pipeline for a domain that does not exist. Keep
# the suffix. Do not copy this block into a ``.yml`` for a domain the app
# builds: the runner finds its pipeline by name, and a second pipeline with
# the same SQL would write the same ``_slots`` table.
#
# Settings the runner applies (see ``SlotPipelineRunner.ensure``):
# - ``name`` -- ``ontobricks-slots-<domain>-v<n>`` (``SlotPipelineRunner.pipeline_name``,
#   lower-case, dash-separated); the runner looks the pipeline up by this name.
# - ``serverless: true`` -- the slot pipeline needs serverless compute; a
#   workspace without it resolves the domain to ``full`` or to the MERGE
#   fallback (``serverless_unavailable``).
# - ``channel`` -- ``PREVIEW`` by default (``settings.slot_pipeline_channel``):
#   Enzyme incremental refresh of the ``_data`` MV and the MV change feed are
#   preview features.
# - ``development: false`` -- the pipeline is production-shaped.
# - ``continuous`` -- ``false`` for the ``incremental`` mode (one triggered
#   update per build) and ``true`` for ``microbatch`` (a triggered bootstrap
#   update first, then the continuous update is left running).
# - ``catalog`` / ``schema`` -- the domain's Delta catalog and schema; the
#   ``_slots`` table and the ``_data`` MV land next to the gateway VIEW.
# - ``configuration.ontobricks.slot_sql_sha256`` -- the SHA-256 of the compiled
#   SQL (``SlotPipelineRunner.FINGERPRINT_KEY``). The runner compares it with
#   the freshly compiled SQL to decide between a full refresh and an
#   incremental update, and stamps the new value after a successful run.
#
# resources:
#   pipelines:
#     ontobricks_slots_<domain>_v<n>:
#       name: "ontobricks-slots-<domain>-v<n>"
#       serverless: true
#       channel: PREVIEW
#       development: false
#       continuous: false            # true for the microbatch mode
#       catalog: <catalog>
#       schema: <schema>
#       libraries:
#         - file:
#             path: /Workspace/Users/<app principal>/.ontobricks/pipelines/ontobricks-slots-<domain>-v<n>.sql
#       configuration:
#         ontobricks.slot_sql_sha256: "<sha256 of the compiled SQL>"
