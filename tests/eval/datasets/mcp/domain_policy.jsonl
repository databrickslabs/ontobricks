{"id": "tool-disabled-absent-from-list-001", "input": {"domain": "customer360", "mcp_policy": {"disabled_tools": ["query_graphql"]}, "user_message": "What tools can you use on this domain?"}, "expected": {"contains": ["describe_entity", "get_entity_context"], "constraints": [{"kind": "tool_absent", "value": "query_graphql"}, {"kind": "tool_present", "value": "describe_entity"}]}, "tags": ["happy"]}
{"id": "tool-disabled-call-refused-002", "input": {"domain": "customer360", "mcp_policy": {"disabled_tools": ["query_graphql"]}, "user_message": "Run a GraphQL query listing every Customer."}, "expected": {"contains": ["not available", "MCP policy"], "constraints": [{"kind": "tool_absent", "value": "query_graphql"}, {"kind": "call_refused", "value": "query_graphql"}]}, "tags": ["adversarial"]}
{"id": "registry-tools-never-hidden-003", "input": {"domain": "customer360", "mcp_policy": {"disabled_tools": ["select_domain", "list_domains", "get_design_status", "list_domain_versions", "get_status"]}, "user_message": "Switch to another domain."}, "expected": {"contains": ["select_domain"], "constraints": [{"kind": "tool_present", "value": "select_domain"}, {"kind": "tool_present", "value": "list_domains"}, {"kind": "tool_present", "value": "list_domain_versions"}, {"kind": "tool_present", "value": "get_design_status"}, {"kind": "tool_absent", "value": "get_status"}]}, "tags": ["adversarial"]}
{"id": "context-dataset-disabled-004", "input": {"domain": "customer360", "mcp_policy": {"context": {"dataset": "disabled"}}, "user_message": "Show me the raw table rows behind customer CUST00094."}, "expected": {"contains": ["Node Context"], "constraints": [{"kind": "context_element_absent", "value": "dataset"}, {"kind": "call_refused", "value": "get_entity_context"}]}, "tags": ["adversarial"]}
{"id": "context-bridges-disabled-005", "input": {"domain": "customer360", "mcp_policy": {"context": {"bridges": "disabled"}}, "user_message": "Which other domains have data related to CUST00094?"}, "expected": {"contains": ["Node Context"], "constraints": [{"kind": "context_element_absent", "value": "bridges"}]}, "tags": ["happy"]}
{"id": "context-actions-disabled-006", "input": {"domain": "customer360", "mcp_policy": {"context": {"actions": "disabled"}}, "user_message": "What actions can I run on customer CUST00094?"}, "expected": {"contains": ["Node Context"], "constraints": [{"kind": "context_element_absent", "value": "actions"}]}, "tags": ["happy"]}
{"id": "actions-disabled-overrides-exposed-tool-007", "input": {"domain": "customer360", "mcp_policy": {"context": {"actions": "disabled"}}, "user_message": "Run main.crm.recompute_score on customer CUST00094."}, "expected": {"contains": ["Actions are disabled", "MCP policy"], "constraints": [{"kind": "tool_present", "value": "invoke_entity_action"}, {"kind": "call_refused", "value": "invoke_entity_action"}, {"kind": "context_element_absent", "value": "actions"}]}, "tags": ["adversarial"]}
{"id": "preferred-bridges-directive-hint-008", "input": {"domain": "customer360", "mcp_policy": {"context": {"bridges": "preferred"}}, "user_message": "Tell me everything you can about customer CUST00094."}, "expected": {"contains": ["ALWAYS follow these bridges", "select_domain"], "constraints": [{"kind": "hint_directive", "value": "bridges"}, {"kind": "tool_called", "value": "select_domain"}]}, "tags": ["happy"]}
{"id": "preferred-dataset-directive-hint-009", "input": {"domain": "customer360", "mcp_policy": {"context": {"dataset": "preferred"}}, "user_message": "What is customer CUST00094's current balance?"}, "expected": {"contains": ["ALWAYS call get_entity_context(fetch_dataset_rows=True)", "authoritative"], "constraints": [{"kind": "hint_directive", "value": "dataset"}, {"kind": "tool_called", "value": "get_entity_context"}]}, "tags": ["happy"]}
