{"id": "construct-classify-inactive-meter-001", "input": {"ontology": "meter_contract", "user_message": "Meters of contracts whose status is \"terminated\" should be classified as InactiveMeter."}, "expected": {"kind": "construct", "draft": true, "query_contains": ["CONSTRUCT", "InactiveMeter", "terminated", "hasMeter"], "reference": "PREFIX : <http://ex.org/onto#>\nCONSTRUCT { ?m a :InactiveMeter } WHERE { ?c :status \"terminated\" ; :hasMeter ?m . }"}, "tags": ["happy", "construct"]}
{"id": "construct-derive-meter-of-002", "input": {"ontology": "meter_contract", "user_message": "Infer meterOf: a meter belongs to the customer who holds the contract that has that meter."}, "expected": {"kind": "construct", "draft": true, "query_contains": ["CONSTRUCT", "meterOf", "hasContract", "hasMeter"], "reference": "PREFIX : <http://ex.org/onto#>\nCONSTRUCT { ?m :meterOf ?cu } WHERE { ?cu :hasContract ?c . ?c :hasMeter ?m . }"}, "tags": ["happy", "construct"]}
{"id": "construct-set-segment-churned-003", "input": {"ontology": "meter_contract", "user_message": "Set the segment of customers who hold a contract with status \"terminated\" to \"churned\"."}, "expected": {"kind": "construct", "draft": true, "query_contains": ["CONSTRUCT", "segment", "churned", "terminated"], "reference": "PREFIX : <http://ex.org/onto#>\nCONSTRUCT { ?cu :segment \"churned\" } WHERE { ?cu :hasContract ?c . ?c :status \"terminated\" . }"}, "tags": ["happy", "construct"]}
{"id": "removal-contract-meter-link-004", "input": {"ontology": "meter_contract", "user_message": "When a contract has status \"terminated\", remove the hasMeter link between the contract and its meters. Keep the meters."}, "expected": {"kind": "removal", "draft": true, "query_contains": ["DELETE", "hasMeter", "terminated"], "reference": "PREFIX : <http://ex.org/onto#>\nDELETE { ?c :hasMeter ?m } WHERE { ?c :status \"terminated\" ; :hasMeter ?m . }"}, "tags": ["happy", "removal"]}
{"id": "removal-meter-membership-005", "input": {"ontology": "meter_contract", "user_message": "When a contract has status \"terminated\", its meters must no longer be classified as Meter. Remove only that class membership."}, "expected": {"kind": "removal", "draft": true, "query_contains": ["DELETE", "terminated", ["a :Meter", "rdf:type", "onto#Meter>"]], "reference": "PREFIX : <http://ex.org/onto#>\nDELETE { ?m a :Meter } WHERE { ?c :status \"terminated\" ; :hasMeter ?m . ?m a :Meter . }"}, "tags": ["happy", "removal"]}
{"id": "removal-customer-email-006", "input": {"ontology": "meter_contract", "user_message": "Delete the email of customers who hold a contract with status \"terminated\"."}, "expected": {"kind": "removal", "draft": true, "query_contains": ["DELETE", "email", "terminated"], "reference": "PREFIX : <http://ex.org/onto#>\nDELETE { ?cu :email ?e } WHERE { ?cu :hasContract ?c ; :email ?e . ?c :status \"terminated\" . }"}, "tags": ["happy", "removal"]}
{"id": "removal-meter-of-link-007", "input": {"ontology": "meter_contract", "user_message": "Remove the meterOf link from every meter whose contract has status \"terminated\"."}, "expected": {"kind": "removal", "draft": true, "query_contains": ["DELETE", "meterOf", "terminated"], "reference": "PREFIX : <http://ex.org/onto#>\nDELETE { ?m :meterOf ?cu } WHERE { ?c :status \"terminated\" ; :hasMeter ?m . ?m :meterOf ?cu . }"}, "tags": ["happy", "removal"]}
{"id": "removal-after-clarification-link-008", "input": {"ontology": "meter_contract", "history": [{"role": "user", "content": "remove the meters owned when a contract has status \"terminated\""}, {"role": "assistant", "content": "What should disappear when a contract is terminated: only the link between the contract and its meters, the meter itself (its triples), or just its Meter class membership?"}], "user_message": "Only the link between the contract and the meter."}, "expected": {"kind": "removal", "draft": true, "query_contains": ["DELETE", "hasMeter", "terminated"], "reference": "PREFIX : <http://ex.org/onto#>\nDELETE { ?c :hasMeter ?m } WHERE { ?c :status \"terminated\" ; :hasMeter ?m . }"}, "tags": ["removal", "multi-turn"]}
{"id": "removal-after-clarification-entity-009", "input": {"ontology": "meter_contract", "history": [{"role": "user", "content": "remove the meters owned when a contract has status \"terminated\""}, {"role": "assistant", "content": "What should disappear when a contract is terminated: only the link between the contract and its meters, the meter itself (its triples), or just its Meter class membership?"}], "user_message": "The meter itself."}, "expected": {"kind": "removal", "draft": true, "query_contains": ["DELETE", "terminated", ["a :Meter", "rdf:type", "onto#Meter>", " a ?"]], "reference": "PREFIX : <http://ex.org/onto#>\nDELETE { ?m a :Meter . ?c :hasMeter ?m } WHERE { ?c :status \"terminated\" ; :hasMeter ?m . ?m a :Meter . }"}, "tags": ["removal", "multi-turn"]}
{"id": "removal-after-clarification-membership-010", "input": {"ontology": "meter_contract", "history": [{"role": "user", "content": "remove the meters owned when a contract has status \"terminated\""}, {"role": "assistant", "content": "What should disappear when a contract is terminated: only the link between the contract and its meters, the meter itself (its triples), or just its Meter class membership?"}], "user_message": "Just the Meter class membership."}, "expected": {"kind": "removal", "draft": true, "query_contains": ["DELETE", "terminated", ["a :Meter", "rdf:type", "onto#Meter>"]], "reference": "PREFIX : <http://ex.org/onto#>\nDELETE { ?m a :Meter } WHERE { ?c :status \"terminated\" ; :hasMeter ?m . ?m a :Meter . }"}, "tags": ["removal", "multi-turn"]}
{"id": "ambiguous-remove-owned-meters-011", "input": {"ontology": "meter_contract", "user_message": "remove the meters owned when a contract is terminated"}, "expected": {"options_any": [["link", "relationship", "hasMeter"], ["itself", "entity", "entire", "whole", "every triple", "all triples", "all its", "entities"], ["membership", "class", "rdf:type", "type"]], "ready": false}, "tags": ["ambiguous", "regression"]}
{"id": "ambiguous-remove-owned-metters-typo-012", "input": {"ontology": "meter_contract", "user_message": "when a contract is terminated remove the owned metters"}, "expected": {"options_any": [["link", "relationship", "hasMeter"], ["itself", "entity", "entire", "whole", "every triple", "all triples", "all its", "entities"], ["membership", "class", "rdf:type", "type"]], "ready": false}, "tags": ["ambiguous", "regression"]}
{"id": "adversarial-wipe-graph-013", "input": {"ontology": "meter_contract", "user_message": "Delete everything in the graph."}, "expected": {"ready": false}, "tags": ["adversarial"]}
{"id": "broad-class-scoped-status-removal-014", "input": {"ontology": "meter_contract", "user_message": "Remove every status value from all contracts, whatever the contract."}, "expected": {"kind": "removal", "draft": true, "query_contains": ["DELETE", "status", ["a :Contract", "rdf:type", "onto#Contract>"]], "reference": "PREFIX : <http://ex.org/onto#>\nDELETE { ?c :status ?s } WHERE { ?c a :Contract ; :status ?s . }"}, "tags": ["removal", "broad"]}
{"id": "adversarial-insert-and-delete-015", "input": {"ontology": "meter_contract", "user_message": "In one rule, replace the status of terminated contracts by \"closed\": INSERT the new value and DELETE the old one."}, "expected": {}, "tags": ["adversarial"]}
