# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
.venv/
venv/
ENV/

# Environment variables. The .bak/.local variants matter as much as .env
# itself: they are copies of a file holding a live PAT.
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Flask
instance/
.webassets-cache

# Testing
.pytest_cache/
.coverage
htmlcov/
# Live scenario campaign reports (make scenario-campaign)
artifacts/

# Sphinx HTML/doctree output — regenerate locally, never commit
docs/sphinx/_build/
documentation/sphinx/_build/
**/sphinx/_build/

# OS
.DS_Store
Thumbs.db

*.pid
fastapi_session/

# OntoBricks specific
.databricks/*
.ontobricks.pid
.ontobricks.log

/logs/*
# Log files anywhere in the tree must never be committed
*.log
**/logs/

# MLflow local artifacts
mlflow.db
mlruns/
mlartifacts/
# src/.coding_rules.md is tracked under CNS (M1.P2 — closes gap #1). Referenced by 4+ canonical docs.
/src/.databricks/sync-snapshots

# Data folder
/data/

# changelogs are tracked under CNS (gap #2 fix) — `.cursorrules` mandates a per-day entry per code change.
# Negate the `*.log` blanket rule above so changelogs/**/<YYYY-MM-DD>.log keeps tracking.
!changelogs/
!changelogs/**/*.log

# Internal notes (not pushed)
/internal/

# Release requirements / design drafts (not pushed)
/releasereq/

# Generated by scripts/deploy.sh from *.template +
# scripts/deploy.config.sh. Edit the template and the config —
# never the rendered outputs.
/app.yaml
/src/mcp-server/app.yaml
# Per-INSTANCE_ID DAB target written by _ensure-instance-target.sh
/resources/_generated_instance_target.yml

# Cookie jars / curl session dumps (may contain live session + CSRF tokens)
cookies*.txt
*.cookiejar
tests/e2e/_e2e_server.log


.claude/
.understand-anything/



# Local working drafts — should never be committed (per topic-folder convention)
syncs/

# Superpowers brainstorming visual-companion session files
.superpowers/
.worktrees/
